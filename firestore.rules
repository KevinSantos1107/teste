rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra geral: Permite leitura e escrita para TODO O SITE (Albuns, Timeline, Playlists, etc),
    // EXCETO para as 3 coleções sensíveis que estamos protegendo agora.
    match /{col}/{document=**} {
      allow read, write: if col != 'player_tokens' 
                         && col != 'game_records' 
                         && col != 'player_links';
    }

    // 🔒 PROTEÇÕES ESPECÍFICAS 🔒 //

    // 1. Tokens mágicos de login
    match /player_tokens/{tokenId} {
      allow get: if true;
      allow get: if true;
      allow list, write: if request.auth != null && request.auth.token.email != null;

    // 2. Recordes dos mini-games
    match /game_records/{recordId} {
      allow read: if true;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/player_links/$(request.auth.uid))
                   && get(/databases/$(database)/documents/player_links/$(request.auth.uid)).data.player == request.resource.data.player;
    }

    // 3. Vínculo entre a UID anônima e o jogador
    match /player_links/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid 
                   && exists(/databases/$(database)/documents/player_tokens/$(request.resource.data.tokenId))
                   && get(/databases/$(database)/documents/player_tokens/$(request.resource.data.tokenId)).data.player == request.resource.data.player;
    }
  }
}
