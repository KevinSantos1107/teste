rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Tokens mágicos para login de jogadores (permite apenas leitura do documento específico, sem listagem)
    match /player_tokens/{tokenId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Recordes dos mini-games (um documento por jogador por jogo: ex "snake_kevin")
    // - Qualquer um pode ler (necessário para exibir o ranking)
    // - Só o usuário autenticado pode escrever — e apenas o documento do seu próprio jogador
    // NOTA: neste estágio o campo "player" ainda é validado no frontend.
    // A Fase 3 adicionará a regra de vínculo uid<->player no Firestore para proteção total.
    match /game_records/{recordId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sites configuration and public data
    match /sites/{siteId} {
      // Anyone can read the site configuration (needed for visitors to see the site)
      allow read: if true;
      
      // Only super_admin can create/update/delete any site
      // Or a specific site_admin can edit their own site
      allow write: if request.auth != null && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.site_admin == siteId
      );

      // Collections inside the site (album, timeline, playlist)
      match /{collectionName}/{docId} {
        // Anyone can read public content
        allow read: if true;
        
        // Same write rules as the parent site
        allow write: if request.auth != null && (
          request.auth.token.role == 'super_admin' || 
          request.auth.token.site_admin == siteId
        );
      }
    }
  }
}
